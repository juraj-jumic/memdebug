# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# memdebug's own data. Ledgers, settings, copies of other apps' databases and reports contain MEMORY TEXT (and sometimes chats)
# and must never be committed.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.partial
stores.json
copies/
backups/
memdebug-report*
# Rollback backups hold the notes byte for byte, and agent session logs are whole conversations. If a test ever needs a made-up .jsonl file,
# add a negation for that one path (!tests/data/example.jsonl) instead of removing the rule.
*.jsonl

# Secrets
.env
*.pem
*.key

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
